{
  "app": {
    "title": "Tree-related Microhabitat & Species Explorer",
    "subtitle": "Explore relationships between Tree-related Microhabitats (TreMs) and associated species",
    "dataFile": "../data/Tree_TreMs_species spreadsheet.csv"
  },
  "filterHierarchy": [
    {
      "level": 1,
      "id": "woodland_type",
      "title": "1. Woodland Type",
      "description": "Select the woodland context (select one or more)",
      "filters": [
        { "id": "woodland", "label": "Woodland", "column": "woodland" },
        { "id": "parkland", "label": "Parkland", "column": "parkland/open grown" },
        { "id": "tow", "label": "Trees Outside Woodland", "column": "ToW" }
      ]
    },
    {
      "level": 2,
      "id": "tree_characteristics",
      "title": "2. Tree Characteristics",
      "description": "Select tree species, age, and condition (select one or more from each)",
      "categories": [
        {
          "title": "Tree Species",
          "filters": [
            { "id": "tree_oak", "label": "Oak", "column": "Tree species", "searchTerm": "oak" },
            { "id": "tree_beech", "label": "Beech", "column": "Tree species", "searchTerm": "beech" },
            { "id": "tree_birch", "label": "Birch", "column": "Tree species", "searchTerm": "birch" },
            { "id": "tree_ash", "label": "Ash", "column": "Tree species", "searchTerm": "ash" }
          ]
        },
        {
          "title": "Tree Age",
          "filters": [
            { "id": "ancient", "label": "Ancient", "column": "woodland age", "searchTerm": "ancient" },
            { "id": "veteran", "label": "Veteran", "column": "Tree age", "searchTerm": "veteran" },
            { "id": "old", "label": "Old", "column": "woodland age", "searchTerm": "old" }
          ]
        },
        {
          "title": "Wood State",
          "filters": [
            { "id": "living", "label": "Living", "column": "Dead wood", "searchTerm": "living" },
            { "id": "dead", "label": "Dead", "column": "Dead wood", "searchTerm": "dead" },
            { "id": "decaying", "label": "Decaying", "column": "Dead wood", "searchTerm": "decaying" },
            { "id": "dying", "label": "Dying", "column": "Dead wood", "searchTerm": "dying" }
          ]
        }
      ]
    },
    {
      "level": 3,
      "id": "microhabitats",
      "title": "3. Microhabitats (Optional)",
      "description": "Optionally filter by specific microhabitat features. If none selected, all microhabitats are shown.",
      "groups": [
        {
          "id": "tree_parts",
          "title": "Tree Parts & Position",
          "categories": [
            {
              "title": "Location",
              "filters": [
                { "id": "trunks", "label": "Trunks", "column": "part of tree", "searchTerm": "trunks" },
                { "id": "branches", "label": "Branches", "column": "part of tree", "searchTerm": "branches" },
                { "id": "roots", "label": "Roots", "column": "part of tree", "searchTerm": "roots" },
                { "id": "stumps", "label": "Stumps", "column": "part of tree", "searchTerm": "stumps" },
                { "id": "canopy", "label": "Canopy", "column": "part of tree", "searchTerm": "canopy" }
              ]
            },
            {
              "title": "Position",
              "filters": [
                { "id": "standing", "label": "Standing", "column": "standing / fallen", "searchTerm": "standing" },
                { "id": "fallen", "label": "Fallen", "column": "standing / fallen", "searchTerm": "fallen" }
              ]
            }
          ]
        },
        {
          "id": "decay_types",
          "title": "Decay Types",
          "categories": [
            {
              "title": "Decay",
              "filters": [
                { "id": "heart_rot", "label": "Heart Rot", "column": "Heart Rot" },
                { "id": "red_rot", "label": "Red Rot", "column": "Red-rot" },
                { "id": "white_rot", "label": "White Rot", "column": "White-rot" },
                { "id": "wood_mould", "label": "Wood Mould", "column": "Wood mould" },
                { "id": "root_decay", "label": "Root Decay", "column": "root decay" }
              ]
            }
          ]
        },
        {
          "id": "cavities_holes",
          "title": "Cavities & Holes",
          "categories": [
            {
              "title": "Cavities",
              "filters": [
                { "id": "hollow_cavity", "label": "Hollow Tree Cavity", "column": "tree hollows" },
                { "id": "nest_cavity", "label": "Nest Cavity", "column": "hole with nest" },
                { "id": "rot_holes", "label": "Rot Holes", "column": "rot holes" },
                { "id": "concavity", "label": "Concavity", "column": "concavity" },
                { "id": "tree_hollows", "label": "Tree Hollows", "column": "tree hollows" },
                { "id": "borings", "label": "Borings", "column": "Borings" },
                { "id": "holes", "label": "Holes", "column": "cavity" }
              ]
            }
          ]
        },
        {
          "id": "surface_features",
          "title": "Surface Features",
          "categories": [
            {
              "title": "Bark Features",
              "filters": [
                { "id": "loose_bark", "label": "Loose Bark", "column": "loose bark" },
                { "id": "bark_assoc", "label": "Bark Association", "column": "bark association" },
                { "id": "bark_trem", "label": "Bark TreM", "column": "bark trem" }
              ]
            },
            {
              "title": "Damage & Features",
              "filters": [
                { "id": "injuries", "label": "Injuries", "column": "Injury" },
                { "id": "physical_damage", "label": "Physical Damage", "column": "Physical damage" },
                { "id": "crevices", "label": "Crevices", "column": "crevices" },
                { "id": "dead_canopy", "label": "Dead Canopy", "column": "dead canopy" },
                { "id": "excrescences", "label": "Excrescences", "column": "excrescences" }
              ]
            }
          ]
        },
        {
          "id": "biological_features",
          "title": "Biological Features",
          "categories": [
            {
              "title": "Epiphytes",
              "filters": [
                { "id": "mosses", "label": "Mosses", "column": "Epiphytes", "searchTerm": "mosses" },
                { "id": "lichens", "label": "Lichens", "column": "Epiphytes", "searchTerm": "lichens" },
                { "id": "ivy", "label": "Ivy", "column": "Epiphytes", "searchTerm": "ivy" },
                { "id": "nests", "label": "Nests", "column": "nests" },
                { "id": "ferns", "label": "Ferns", "column": "Epiphytes", "searchTerm": "ferns" }
              ]
            },
            {
              "title": "Fungi",
              "filters": [
                { "id": "bracket_fungus", "label": "Bracket Fungus", "column": "fungal fruiting body", "searchTerm": "bracket" },
                { "id": "perennial_fungi", "label": "Perennial Fungi", "column": "perennial fungi" },
                { "id": "ephemeral_fungi", "label": "Ephemeral Fungi", "column": "ephemeral fungi" },
                { "id": "fungal_fruiting", "label": "Fungal Fruiting Bodies", "column": "fungal fruiting body" }
              ]
            },
            {
              "title": "Other",
              "filters": [
                { "id": "exudates", "label": "Exudates", "column": "exudates" },
                { "id": "flowers_nectar", "label": "Flowers/Nectar", "column": "Flowers/nectar?" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "forestDark": "#2c3e2f",
    "forestMedium": "#4a6741",
    "forestLight": "#7a9d72",
    "barkBrown": "#8b7355",
    "stoneGrey": "#5a5a5a",
    "lightGrey": "#e8e8e8"
  }
}