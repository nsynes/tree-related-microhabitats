    {"key": "habitatRequirements",  "column": "Description"},
    {"key": "priorityEngland",      "column": "Priority (England)",         "type": "yes_blank"},
    {"key": "priorityScotland",     "column": "Priority (Scotland)",        "type": "yes_blank"},
    {"key": "priorityWales",        "column": "Priority_Wales",             "type": "yes_blank"},
    {"key": "priorityNI",           "column": "Priority_NI",                "type": "yes_blank"},
    {"key": "d4",                   "column": "D4",                         "type": "yes_blank"},
    {"key": "d5",                   "column": "D5",                         "type": "yes_blank"},
    {"key": "tsra",                 "column": "TSRA",                       "type": "yes_blank"}
