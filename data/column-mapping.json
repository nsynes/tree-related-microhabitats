{
  "description": "Tree-Related Microhabitats - Filter Hierarchy Configuration",
  "pipeline": {
    "speciesDataFile": "data/SpeciesTreMsPaper_v1_29April.xlsx",
    "speciesDataSheet": "version for publ",
    "speciesDataHeaderRow": 6
  },
  "hierarchy": {
    "level1": {
      "id": "geographic_location",
      "title": "1. Geographic Location",
      "description": "Filter by geographic location",
      "filters": [
        {"id": "england", "label": "England", "column": "England"},
        {"id": "scotland", "label": "Scotland", "column": "Scotland"},
        {"id": "wales", "label": "Wales", "column": "Wales"}
      ]
    },

    "level2": {
      "id": "woodland_tree_type",
      "title": "2. Woodland and Tree Characteristics",
      "description": "Filter by woodland, tree type and age",
      "categories": [
        {
          "title": "Woodland Type",
          "filters": [
            {"id": "closed_canopy", "label": "Closed Canopy", "column": "ClosedCanopy"},
            {"id": "open_grown", "label": "Open Grown", "column": "OpenGrown"}
          ]
        },
        {
          "title": "Tree Type",
          "filters": [
            {"id": "conifer", "label": "Conifer", "column": "Conifer"},
            {"id": "broadleaved", "label": "Broadleaved", "column": "Broadleaved"}
          ]
        }
      ]
    },
    
    "level3": {
      "id": "microhabitats",
      "title": "3. Tree-related Microhabitats",
      "description": "Filter by tree-related microhabitats",
      "groups": [
        {
          "id": "cavity",
          "title": "Cavity",
          "description": "Holes or sheltered spots in the tree, dry or wet, with or without wood mould; located on the trunk, in the crown, or at the root collar.",
          "categories": [
            {
              "title": "Woodpecker breeding cavities",
              "filters": [
                {"id": "medium_woodpecker_nest", "label": "Medium Woodpecker Nesthole", "column": "MediumWoodpeckerNesthole"},
                {"id": "small_woodpecker_nest", "label": "Small Woodpecker Nesthole", "column": "SmallWoodpeckerNesthole"},
                {"id": "large_woodpecker_nest", "label": "Large Woodpecker Nesthole", "column": "LargeWoodpeckerNesthole"},
                {"id": "other_nest_hole", "label": "Other Nesthole", "column": "OtherNestHole"}
              ]
            },
            {
              "title": "Rot Holes",
              "filters": [
                {"id": "trunk_base_rot", "label": "Trunk-base Rot Hole", "column": "Trunk-baseRotHole"},
                {"id": "trunk_rot", "label": "Trunk Rot Hole", "column": "TrunkRotHole"},
                {"id": "semi_open_rot", "label": "Semi-open Rot Hole", "column": "SemiOpenRotHole"},
                {"id": "chimney_trunk_base_rot", "label": "Chimney Trunk-base Rot Hole", "column": "ChimneyTrunk-baseRotHole"},
                {"id": "chimney_trunk_rot", "label": "Chimney Trunk Rot Hole", "column": "ChimneyTrunkRotHole"},
                {"id": "hollow_branch", "label": "Hollow Branch", "column": "HollowBranch"}
              ]
            },
            {
              "title": "Insect Galleries",
              "filters": [
                {"id": "insect_gallery_and_borehole", "label": "Insect Gallery and Borehole", "column": "InsectGallery andBorehole"}
              ]
            },
            {
              "title": "Concavities",
              "filters": [
                {"id": "dendrotelm", "label": "Dendrotelm", "column": "Dendrotelm"},
                {"id": "woodpecker_foraging", "label": "Woodpecker Foraging", "column": "WoodpeckerForaging"},
                {"id": "bark_lined_concavity", "label": "Bark-lined Concavity", "column": "Bark-lined concavity"},
                {"id": "buttress_root_concavity", "label": "Buttress Root Concavity", "column": "ButtressRootConcavity"}
              ]
            }
          ]
        },
        {
          "id": "injury",
          "title": "Injuries & Exposed Wood",
          "description": "Sapwood or heartwood is exposed due to bark loss, splitting, or breakage.",
          "categories": [
            {
              "title": "Exposed Sapwood only",
              "filters": [
                {"id": "bark_loss", "label": "Bark Loss", "column": "BarkLoss"},
                {"id": "fire_scar", "label": "Fire Scar", "column": "FireScar"},
                {"id": "bark_shelter", "label": "Bark Shelter", "column": "BarkShelter"},
                {"id": "bark_pocket", "label": "Bark Pocket", "column": "BarkPocket"}
              ]
            },
            {
              "title": "Exposed Sapwood and Heartwood",
              "filters": [
                {"id": "stem_breakage", "label": "Stem Breakage", "column": "StemBreakage"},
                {"id": "limb_breakage", "label": "Limb Breakage", "column": "LimbBreakage"},
                {"id": "crack", "label": "Crack", "column": "Crack"},
                {"id": "lightning_scar", "label": "Lightning Scar", "column": "LightningScar"},
                {"id": "fork_split", "label": "Fork Split", "column": "ForkSplit"},
                {"id": "beaver_gnawing", "label": "Beaver Gnawing", "column": "BeaverGnawing"}
              ]
            }
          ]
        },
        {
          "id": "crown_deadwood",
          "title": "Crown Deadwood",
          "description": "Deadwood located in the crown of the tree.",
          "categories": [
            {
              "title": "Dead Branches",
              "filters": [
                {"id": "dead_branches", "label": "Dead Branches", "column": "DeadBranches"},
                {"id": "dead_top", "label": "Dead Top", "column": "DeadTop"},
                {"id": "remnant_broken_limb", "label": "Remnant Broken Limb", "column": "RemnantBrokenLimb"}
              ]
            }
          ]
        },
        {
          "id": "excrescences",
          "title": "Excrescences",
          "description": "Excrescences caused by a reaction of the tree to light or an attack by bacteria, fungi, viruses, or arthropods.",
          "categories": [
            {
              "title": "Twig Tangles",
              "filters": [
                {"id": "witches_broom", "label": "Witches Broom", "column": "WitchesBroom"},
                {"id": "epicormic", "label": "Epicormic Shoots", "column": "EpicormicShoots"}
              ]
            },
            {
              "title": "Galls",
              "filters": [
                {"id": "galls", "label": "Galls", "column": "Galls"}
              ]
            },
            {
              "title": "Burrs and Cankers",
              "filters": [
                {"id": "burr", "label": "Burr", "column": "Burr"},
                {"id": "canker", "label": "Canker", "column": "Canker"}
              ]
            }
          ]
        },
        {
          "id": "fungal_fruiting",
          "title": "Fungal fruiting bodies and slime moulds",
          "description": "The reproductive structures of saproxylic fungi or slime mould plasmodia, lasting from a few days to several weeks. ",
          "categories": [
            {
              "title": "Perennial fungal fruiting bodies",
              "filters": [
                {"id": "perennial_polypore", "label": "Perennial Polypore", "column": "PerennialPolypore"}
              ]
            },
            {
              "title": "Ephemeral fungal fruiting bodies",
              "filters": [
                {"id": "annual_polypore", "label": "Annual Polypore", "column": "AnnualPolypore"},
                {"id": "pulpy_agaric", "label": "Pulpy Agaric", "column": "PulpyAgaric"},
                {"id": "crustose_fungi", "label": "Crustose Fungi", "column": "CrustoseFungi"},
                {"id": "pyrenomycetoid", "label": "Pyrenomycetoid", "column": "Pyrenomycetoid"}
              ]
            },
            {
              "title": "Slime Moulds",
              "filters": [
                {"id": "slime_mould", "label": "Slime Mould", "column": "SlimeMould"}
              ]
            }
          ]
        },
        {
          "id": "epixylic",
          "title": "Epiphytic and epixylic structures",
          "description": "Formations or living organisms that use the tree mainly as a physical support.",
          "categories": [
            {
              "title": "Epiphytes",
              "filters": [
                {"id": "bryophyte", "label": "Bryophyte", "column": "Bryophyte"},
                {"id": "lichen", "label": "Lichen", "column": "Lichen"},
                {"id": "ivy_and_liana", "label": "Ivy and Liana", "column": "Ivy&Liana"},
                {"id": "ferns", "label": "Ferns", "column": "Ferns"},
                {"id": "mistletoe", "label": "Mistletoe", "column": "Mistletoe"}
              ]
            },
            {
              "title": "Nests",
              "filters": [
                {"id": "vertebrate_nest", "label": "Vertebrate Nest", "column": "VertebrateNest"},
                {"id": "invertebrate_nest", "label": "Invertebrate Nest", "column": "InvertebrateNest"}
              ]
            },
            {
              "title": "Microsoil",
              "filters": [
                {"id": "bark_microsoil", "label": "Bark Microsoil", "column": "BarkMicrosoil"},
                {"id": "inter_bark_microsoil", "label": "Inter-bark Microsoil", "column": "Inter-barkMicrosoil"},
                {"id": "crown_microsoil", "label": "Crown Microsoil", "column": "CrownMicrosoil"}
              ]
            },
            {
              "title": "Alluvial Deposits",
              "filters": [
                {"id": "lay_silt_deposit", "label": "Lay Silt Deposit", "column": "LaySiltDeposit"}
              ]
            }
          ]
        },
        {
          "id": "exudates",
          "title": "Exudates",
          "description": "Sap run or resinosis.",
          "categories": [
            {
              "title": "",
              "filters": [
                {"id": "sap_run", "label": "Sap Run", "column": "SapRun"},
                {"id": "heavy_resinosis", "label": "Heavy Resinosis", "column": "HeavyResinosis"}
              ]
            }
          ]
        }
      ]
    }
  },
  
  "speciesMetadataColumns": [
    {"key": "scientificName",      "column": "Scientific name"},
    {"key": "commonName",          "column": "Common name"},
